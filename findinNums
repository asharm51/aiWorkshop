/**
 * mygrep is my version of the linux grep command
 * the way to execute:
 * node findinNums.js <FILENAME> <PATTERN> <LINE #'s>
 */


const fs = require('fs');
const path = require('path')

let lineNum;
if (process.argv.length < 3) {
  console.log('Missing Argument');
  console.log(`Usage: node ${path.basename(process.argv[1])} <FILENAME> <PATTERN> <LINE #>`);
  return;
} else if (process.argv.length === 5) {
  lineNum = process.argv[4];
} else {
  lineNum = 10;
}
let filename = process.argv[2];
let pattern = process.argv[3]

let content = fs.readFileSync(filename, 'utf-8');


let lines = content.split('\n')
for (i = 0; i < lineNum; i++)
  if (lines[i].includes(pattern)){
      console.log(`LINE NUM : ${i} ` + lines[i])
  }
